{
  "expo": {
    "name": "KrianStyle",
    "slug": "krianstyle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "krianstyle",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.krianstyle.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050B1C"
      }
    },
    "ios": {
      "bundleIdentifier": "com.krianstyle.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
